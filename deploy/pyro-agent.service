# Pyro load agent on a machine without Docker (no web UI; listens on port 7979).
#
#   sudo useradd --system --home /var/lib/pyro-agent --shell /usr/sbin/nologin pyro-agent
#   tar xzf pyro_<version>_linux_amd64.tar.gz          # from the GitHub release
#   sudo install -m 755 pyro_<version>_linux_amd64/pyro /usr/local/bin/pyro
#   R=https://raw.githubusercontent.com/codeen15/pyro/v<version>/deploy
#   curl -fsSLO $R/pyro-agent.service && curl -fsSLO $R/agent.env.example
#   sudo install -d -m 755 /etc/pyro
#   sudo install -m 640 -g pyro-agent agent.env.example /etc/pyro/agent.env   # set the token
#   sudo install -m 644 pyro-agent.service /etc/systemd/system/pyro-agent.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now pyro-agent
#
# Open port 7979 only to the team server.
[Unit]
Description=Pyro load agent
Documentation=https://github.com/codeen15/pyro/blob/main/docs/guide/distributed.md
After=network-online.target
Wants=network-online.target

[Service]
User=pyro-agent
Group=pyro-agent
Environment=PYRO_PLUGINS_DIR=/var/lib/pyro-agent/plugins
EnvironmentFile=-/etc/pyro/agent.env
ExecStart=/usr/local/bin/pyro agent
StateDirectory=pyro-agent
StateDirectoryMode=0750
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/pyro-agent

[Install]
WantedBy=multi-user.target
