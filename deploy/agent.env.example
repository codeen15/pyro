# Pyro load agent settings. Copy to deploy/.env for docker-compose.agent.yml, paste
# into your platform's environment settings, or use as /etc/pyro/agent.env with
# deploy/pyro-agent.service.

# Token the team server must present: long and random (openssl rand -hex 32).
# Enter the same value when you add the agent under Administration > Agents (Direct),
# or give it to the server's --agent-token. To have the agent connect in instead, use
# Add agent > Connects in: the app shows the command (pyro agent --connect <server> --token <token>).
PYRO_AGENT_TOKEN=

# Image tag (Docker only). Use the same tag as the team server.
PYRO_IMAGE_TAG=latest
# Address and host port to publish on (Docker only). Firewall it to the server.
PYRO_AGENT_BIND=0.0.0.0
PYRO_AGENT_PORT=7979
