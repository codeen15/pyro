# Pyro team server settings. Copy to deploy/.env (Docker Compose), paste into your
# platform's environment settings (e.g. Dokploy's Environment tab), or use as
# /etc/pyro/pyro.env with deploy/pyro.service. Empty means "not set".
# Docker Compose expands $ in values: write a secret containing $ as $$ or in single quotes.
#
# Load agents (optional): the token the server sends to its agents (see the guide).
# PYRO_AGENT_TOKEN=
# Serve HTTPS from Pyro itself instead of a proxy (paths inside the container or machine):
# PYRO_TLS_CERT=/certs/server.crt
# PYRO_TLS_KEY=/certs/server.key

# --- Image (Docker Compose only) ---
# Image tag to pull: latest, a release such as 0.2.0, or edge (main branch).
PYRO_IMAGE_TAG=latest
# Address and host port to publish on. 127.0.0.1 = only a reverse proxy on this
# host can reach it; 0.0.0.0 = open to the network (then serve HTTPS, see the guide).
PYRO_BIND=127.0.0.1
PYRO_HOST_PORT=7878

# --- Server ---
# The address people open. Use https:// behind an HTTPS proxy so cookies are secure.
PYRO_PUBLIC_URL=https://pyro.example.com
# PostgreSQL, e.g. postgres://pyro:secret@db.example.com:5432/pyro?sslmode=require
# Empty = SQLite in the data volume (fine for one machine).
PYRO_DATABASE_URL=
# Key that signs sign-in tokens, at least 32 bytes (openssl rand -hex 32).
# Empty = generated once and kept in the data volume.
PYRO_JWT_SECRET=
# Who may create an account: invite-only (default), open, or domains.
PYRO_SIGNUP=
# With PYRO_SIGNUP=domains: allowed email domains, comma-separated.
PYRO_SIGNUP_DOMAINS=
# Load tests that may run at once across all projects (default 2).
PYRO_MAX_LOADS=
# Plugin index URL for installing plugins from the Plugins tab.
PYRO_PLUGIN_INDEX=

# --- Invite and password-reset emails (optional) ---
PYRO_SMTP_HOST=
PYRO_SMTP_PORT=
PYRO_SMTP_USERNAME=
PYRO_SMTP_PASSWORD=
PYRO_SMTP_FROM=

# --- LDAP / Active Directory sign-in (optional) ---
PYRO_LDAP_URL=
PYRO_LDAP_BIND_DN=
PYRO_LDAP_BIND_PASSWORD=
PYRO_LDAP_BASE_DN=
PYRO_LDAP_USER_FILTER=
PYRO_LDAP_ADMIN_GROUP=
