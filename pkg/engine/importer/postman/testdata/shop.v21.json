{
  "info": {
    "_postman_id": "8b2c3f1e-1111-4a5b-9c9d-000000000001",
    "name": "Shop API",
    "description": { "content": "Demo shop", "type": "text/markdown" },
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ] },
  "variable": [
    { "key": "baseUrl", "value": "https://shop.example.com", "type": "string" },
    { "key": "apiSecret", "value": "s3cr3t", "type": "secret" },
    { "key": "port", "value": 8080 }
  ],
  "event": [
    { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [ "pm.variables.set('ts', Date.now());" ] } }
  ],
  "item": [
    {
      "name": "Auth",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Login",
          "event": [ { "listen": "test", "script": { "exec": [ "pm.test('ok', () => pm.response.to.have.status(200));", "pm.environment.set('token', pm.response.json().token);" ] } } ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"user\":\"{{user}}\"}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": [ "{{baseUrl}}" ], "path": [ "auth", "login" ] }
          },
          "response": [ { "name": "200 OK" } ]
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Get product",
          "request": {
            "method": "GET",
            "header": [ { "key": "X-Debug", "value": "1", "disabled": true } ],
            "url": {
              "raw": "{{baseUrl}}/products/:id?expand=reviews&debug=true",
              "host": [ "{{baseUrl}}" ],
              "path": [ "products", ":id" ],
              "query": [ { "key": "expand", "value": "reviews" }, { "key": "debug", "value": "true", "disabled": true } ],
              "variable": [ { "key": "id", "value": "42" } ]
            }
          }
        },
        {
          "name": "Upload image",
          "request": {
            "method": "POST",
            "auth": { "type": "awsv4", "awsv4": [ { "key": "region", "value": "us-east-1" } ] },
            "body": { "mode": "formdata", "formdata": [
              { "key": "title", "value": "Front", "type": "text" },
              { "key": "image", "type": "file", "src": "/Users/me/front.png" }
            ] },
            "url": "{{baseUrl}}/products/42/images"
          }
        },
        {
          "name": "Search (GraphQL)",
          "request": {
            "method": "POST",
            "body": { "mode": "graphql", "graphql": { "query": "query { products { id } }", "variables": "{\"first\": 10}" } },
            "url": { "raw": "{{baseUrl}}/graphql" }
          }
        },
        {
          "name": "Get product",
          "request": "https://shop.example.com/products/1"
        }
      ]
    },
    {
      "name": "Checkout",
      "event": [ { "listen": "test", "script": { "exec": "pm.visualizer.set('<b>hi</b>')" } } ],
      "request": {
        "method": "POST",
        "auth": { "type": "apikey", "apikey": [ { "key": "key", "value": "X-Api-Key" }, { "key": "value", "value": "{{apiKey}}" } ] },
        "body": { "mode": "urlencoded", "urlencoded": [ { "key": "cart", "value": "abc" }, { "key": "coupon", "value": "X", "disabled": true } ] },
        "url": { "raw": "{{baseUrl}}/checkout" }
      }
    }
  ]
}
