{
  "swagger": "2.0",
  "info": { "title": "Petstore", "version": "1.0" },
  "host": "petstore.test",
  "basePath": "/api",
  "schemes": ["https", "http"],
  "securityDefinitions": { "key": { "type": "apiKey", "name": "api_key", "in": "query" } },
  "security": [ { "key": [] } ],
  "paths": {
    "/pets": {
      "post": {
        "summary": "Add a pet",
        "parameters": [ { "name": "body", "in": "body", "schema": { "type": "object", "properties": { "name": { "type": "string", "example": "Rex" }, "tags": { "type": "array", "items": { "type": "string" } } } } } ]
      }
    },
    "/pets/{petId}/photo": {
      "post": {
        "operationId": "uploadPhoto",
        "consumes": ["multipart/form-data"],
        "parameters": [
          { "name": "petId", "in": "path", "required": true, "type": "integer", "default": 7 },
          { "name": "file", "in": "formData", "type": "file", "required": true },
          { "name": "note", "in": "formData", "type": "string" }
        ]
      }
    }
  }
}
