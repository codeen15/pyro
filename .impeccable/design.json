  "narrative": {
    "northStar": "The Pyrometer's Eye",
    "overview": "A kiln operator judges metal by its glow: dull red, cherry, orange, yellow, white. Pyro reads latency the same way. Every measured duration sits on one incandescence scale, so how slow something ran is visible before the number is read. Everything else stays out of the way: cold iron content, warm kiln-brick shell, dense rows, standard controls.",
    "keyCharacteristics": [
      "One heat ramp, used only on measured data, always with a visible legend.",
      "Cold iron content ground, warm brick shell.",
      "A single flame-orange accent for chrome: primary action, selection, focus.",
      "Dense rows, tabular numerals, monospace only for code, URLs, paths and measurements.",
      "State colours (ok, warn, error) appear only where they carry meaning."
    ],
    "rules": [
      {
        "name": "The Quarantine Rule",
        "body": "Heat colours appear only on measured data: the heat chip, the heated bar, legend swatches, timing values. Never on buttons, menus, borders or decoration.",
        "section": "colors"
      },
      {
        "name": "The Legend Rule",
        "body": "Every place that shows heat can reach its legend: the Timing tab and the welcome screen carry the full scale.",
        "section": "colors"
      },
      {
        "name": "The Lit-Until-Seen Rule",
        "body": "A response at orange heat or hotter keeps its glow until the user opens Timing. A breach is not allowed to fade unnoticed.",
        "section": "colors"
      },
      {
        "name": "The Honest Mono Rule",
        "body": "Monospace marks code, URLs, paths and numbers. It is never used for decoration or to make text look \"technical\".",
        "section": "typography"
      },
      {
        "name": "The Only-Heat-Glows Rule",
        "body": "Nothing else in the interface casts light or shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do put every new measurement (load percentiles, run durations) on the same heat scale with the same thresholds and a reachable legend.",
      "Do keep the shell brick and the content iron; new panels inside main stay iron.",
      "Do use flame for exactly one primary action per area.",
      "Do pair every error colour with an icon or a word.",
      "Do keep tracks minmax(0, 1fr) and let long values scroll inside their field."
    ],
    "donts": [
      "Don't use heat colours on chrome, borders or decoration (The Quarantine Rule).",
      "Don't mark a selected row with a coloured side stripe; use the brick-2 fill.",
      "Don't add shadows for elevation; layer tones instead.",
      "Don't use monospace for prose or labels.",
      "Don't introduce a second accent colour."
    ]
  }
