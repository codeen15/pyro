# Settings for the team server (pyro serve --team) and pyro admin.
# Copy to .env next to where you start Pyro, or pass --env-file.
# Variables already set in the environment win over this file; flags win over both.

# Where accounts live. Empty: SQLite in the data directory (data/pyro.db).
# For a hosted server, use PostgreSQL:
# PYRO_DATABASE_URL=postgres://pyro:CHANGE-ME@db.internal:5432/pyro?sslmode=require

# Project files (collections, environments, load tests) stay on disk here.
# PYRO_DATA_DIR=/var/lib/pyro

# PYRO_HOST=0.0.0.0
# PYRO_PORT=7878
# PYRO_PUBLIC_URL=https://pyro.example.com
# PYRO_TLS_CERT=/etc/pyro/tls.crt
# PYRO_TLS_KEY=/etc/pyro/tls.key

# Who may create an account: invite-only (default), open, or domains.
# PYRO_SIGNUP=domains
# PYRO_SIGNUP_DOMAINS=example.com,example.org

# Load tests running at once across all projects (default 2).
# PYRO_MAX_LOADS=2

# Invite emails (optional).
# PYRO_SMTP_HOST=smtp.example.com
# PYRO_SMTP_PORT=587
# PYRO_SMTP_USERNAME=pyro@example.com
# PYRO_SMTP_PASSWORD=
# PYRO_SMTP_FROM=Pyro <pyro@example.com>

# Distributed load agents.
# PYRO_AGENT_TOKEN=
